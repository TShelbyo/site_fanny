---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, img } from '../lib/site';

const { autrice, pages } = site;
---
<BaseLayout titre={pages.autrice.titre} description={pages.autrice.description} type="profile">
  <section aria-labelledby="titre-autrice" class="relative mx-auto mt-10 max-w-5xl sm:mt-16">
    <div aria-hidden="true" class="absolute -right-8 -top-8 -z-10 size-44 rounded-full bg-peche/50 blur-sm"></div>

    <div class="bulle grid items-center gap-10 md:grid-cols-[2fr_3fr]">
      <div class="relative mx-auto w-3/4 max-w-xs md:w-full">
        <div aria-hidden="true" class="absolute -bottom-4 -left-4 -z-10 size-full rounded-full bg-beurre"></div>
        <Image
          src={img(autrice.photo.image)}
          alt={autrice.photo.alt}
          widths={[320, 480, 640]}
          sizes="(min-width: 768px) 320px, 75vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-square h-auto w-full rounded-full object-cover"
        />
      </div>

      <div>
        <p class="mb-2 font-display text-lg font-medium text-sapin">{pages.autrice.titre}</p>
        <h1 id="titre-autrice" class="mb-6 text-4xl font-semibold sm:text-5xl">{autrice.nom}</h1>
        {autrice.bio.map((p) => <p class="mb-4">{p}</p>)}

        {autrice.reseaux.length > 0 && (
          <div class="mt-8">
            <h2 class="mb-4 text-2xl font-semibold">Me suivre</h2>
            <SocialLinks reseaux={autrice.reseaux} />
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
