---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout titre="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <section class="bulle mx-auto mt-16 max-w-xl text-center">
    <p aria-hidden="true" class="mx-auto mb-6 flex size-24 items-center justify-center rounded-full bg-beurre font-display text-4xl font-semibold text-sapin">404</p>
    <h1 class="text-4xl font-semibold">Page introuvable</h1>
    <p class="mt-4">Cette page s'est envolée comme une bulle.</p>
    <p class="mt-8"><a href="/" class="btn">Retour à l'accueil</a></p>
  </section>
</BaseLayout>
