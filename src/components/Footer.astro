---
import { site } from '../lib/site';
---
<footer class="mt-20 px-4 pb-8">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-3 rounded-[var(--radius-bulle)] bg-menthe px-6 py-8 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <p class="font-display">{site.piedDePage.mention}</p>
    <ul class="flex flex-wrap justify-center gap-4">
      {site.piedDePage.liens.map((l) => (
        <li><a href={l.lien}>{l.libelle}</a></li>
      ))}
    </ul>
  </div>
</footer>
