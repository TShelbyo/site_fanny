---
import { site } from '../lib/site';
const courant = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const estActif = (lien: string) => (lien === '/' ? courant === '/' : courant.startsWith(lien));
---
<header class="px-4 pt-4 sm:pt-6">
  <nav
    aria-label="Navigation principale"
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 rounded-full bg-white/80 px-5 py-3 shadow-sm"
  >
    <a href="/" class="font-display text-xl font-semibold text-sapin no-underline">
      {site.site.nomSite}
    </a>

    <!-- Menu mobile sans JavaScript -->
    <details class="group sm:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-menthe px-4 py-2 font-display font-medium text-sapin [&::-webkit-details-marker]:hidden"
      >
        Menu
        <svg aria-hidden="true" class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
          <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" />
        </svg>
      </summary>
      <ul class="absolute inset-x-4 z-10 mt-3 space-y-1 rounded-[2rem] bg-white p-3 shadow-lg">
        {site.navigation.map((item) => (
          <li>
            <a
              href={item.lien}
              aria-current={estActif(item.lien) ? 'page' : undefined}
              class="block rounded-full px-4 py-3 font-display text-lg no-underline aria-[current=page]:bg-menthe"
            >
              {item.libelle}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <ul class="hidden items-center gap-1 sm:flex">
      {site.navigation.map((item) => (
        <li>
          <a
            href={item.lien}
            aria-current={estActif(item.lien) ? 'page' : undefined}
            class="rounded-full px-4 py-2 font-display font-medium no-underline hover:bg-menthe-pale aria-[current=page]:bg-menthe"
          >
            {item.libelle}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
