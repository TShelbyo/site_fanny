const icone = (nom: string) => icones[nom.trim().toLowerCase()] ?? icones.lien;
---
{reseaux.length > 0 && (
  <ul class="flex flex-wrap gap-3">
    {reseaux.map((r) => (
      <li>
        <a
          href={r.lien}
          rel="me noopener"
          target="_blank"
          class="inline-flex items-center gap-2 rounded-full bg-menthe px-5 py-3 font-display font-medium no-underline hover:bg-sapin hover:text-white"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-current"><path d={icone(r.nom)} /></svg>
          {r.nom}
          <span class="sr-only">(nouvel onglet)</span>
        </a>
      </li>
    ))}
  </ul>
)}
